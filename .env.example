APP_ENV=production
DATABASE_URL=postgresql+psycopg://pond:replace-this-password@postgres:5432/pond
REDIS_URL=redis://redis:6379/0
CELERY_ENABLED=true
OPERATOR_TIMEZONE=Europe/Paris
SESSION_SECRET=generate-a-long-random-value
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-a-second-long-random-value
BOOTSTRAP_ADMIN_EMAIL=operator@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
COOKIE_SECURE=true
TRUSTED_HOSTS=pond.example.com
ALLOWED_ORIGINS=https://pond.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pond.example.com/api/integrations/google/callback
OPENAI_API_KEY=
OPENAI_MODEL=
